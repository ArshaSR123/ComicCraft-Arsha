# ==============================================================
# ComicCraft Environment Configuration
# ==============================================================

# Google Gemini API Key (Required for AI story & outline generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hugging Face Access Token (Required for live Stable Diffusion illustrations)
# Get your free token at: https://huggingface.co/settings/tokens
HF_API_KEY=

# Optional Gemini Model Identifiers (defaults to official gemini-1.5 versions)
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# Optional Stable Diffusion Model ID (Hugging Face Model Hub)
SD_MODEL_ID=runwayml/stable-diffusion-v1-5
